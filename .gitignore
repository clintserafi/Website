# Raw brand-asset dump: source files, not needed for the deployed site.
# Only the specific files copied out (images/logo-horizontal.png, images/favicon.svg) are tracked.
images/Logo PERFORMANCE COLLECTIVE/
images/Performance Collective Branding/

# Blog drafts: source docs, not needed for the deployed site.
BLOGS/
*.txt
!robots.txt
blog_docs_text.txt

# Raw headshot variants (LinkedIn/PRINT/original WEB): only the cropped
# WEB version and the B&W photo used in about.html are tracked.
images/Headshot Updated 20241126/*Linkedin.jpg
images/Headshot Updated 20241126/*PRINT.jpg
images/Headshot Updated 20241126/*WEB.jpg
*.heic

# Raw video sources (iPhone .mov): remuxed to web-friendly .mp4 and tracked
# as images/clint-baseball-*.mp4. The originals aren't needed for the site.
images/*.mov
images/*.MP4
!images/clint-baseball-*.mp4

# Source doc, not needed for the deployed site (content pulled into about.html).
